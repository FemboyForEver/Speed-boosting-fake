-- ========= REBIND DES TOUCHES DYNAMIQUES =========
local waitingBind = nil
local rebindButtons = {}

local function startBind(action)
	waitingBind = action
	Rayfield:Notify({Title = "Rebind", Content = "Appuie sur une touche de ton clavier ou de ta manette", Duration = 4})
end

local function getBindText(action)
	return "[" .. binds[action].Keyboard.Name .. "] / [" .. binds[action].Gamepad.Name .. "]"
end

rebindButtons.boost = BoostPage:CreateButton({ Name = "Changer Boost " .. getBindText("boost"), Callback = function() startBind("boost") end })
rebindButtons.brake = BrakePage:CreateButton({ Name = "Changer Frein " .. getBindText("brake"), Callback = function() startBind("brake") end })
rebindButtons.stop = BrakePage:CreateButton({ Name = "Changer Stop " .. getBindText("stop"), Callback = function() startBind("stop") end })
rebindButtons.jump = JumpPage:CreateButton({ Name = "Changer Jump " .. getBindText("jump"), Callback = function() startBind("jump") end })
rebindButtons.accel = SpeedPage:CreateButton({ Name = "Changer Accélération " .. getBindText("accel"), Callback = function() startBind("accel") end })
rebindButtons.flyToggle = AdvancedFlyPage:CreateButton({ Name = "Touche Activer Vol " .. getBindText("flyToggle"), Callback = function() startBind("flyToggle") end })

-- ========= ECOUTEURS INTERNES INPUTBEGAN / ENDED (MANETTE & CLAVIER) =========
local function checkInputMatch(input, action)
	if input.UserInputType == Enum.UserInputType.Keyboard then
		return input.KeyCode == binds[action].Keyboard
	elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
		return input.KeyCode == binds[action].Gamepad
	end
	return false
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	-- Traitement des demandes de Rebind
	if waitingBind then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			binds[waitingBind].Keyboard = input.KeyCode
		elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
			binds[waitingBind].Gamepad = input.KeyCode
		else
			return
		end
		
		if rebindButtons[waitingBind] then
			local ActionCleanName = waitingBind:gsub("^%l", string.upper)
			if waitingBind == "flyToggle" then ActionCleanName = "Activer Vol" end
			rebindButtons[waitingBind]:Set("Changer " .. ActionCleanName .. " " .. getBindText(waitingBind))
		end
		
		waitingBind = nil
		Rayfield:Notify({Title="Rebind", Content="Touche mise à jour !", Duration=2})
		return
	end

	-- Triggers d'actions physiques standards
	if checkInputMatch(input, "boost") then Boost()
	elseif checkInputMatch(input, "accel") then accelerating = true
	elseif checkInputMatch(input, "brake") then Brake()
	elseif checkInputMatch(input, "stop") then Stop()
	elseif checkInputMatch(input, "jump") then Jump()
	elseif checkInputMatch(input, "flyToggle") then 
		FlyEnabled = not FlyEnabled
		FlyButton.Text = FlyEnabled and "UnFly" or "Fly"
		FlyToggleUI:Set(FlyEnabled)
		if FlyEnabled then EnableFlight() else DisableFlight() end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if checkInputMatch(input, "accel") then 
		accelerating = false 
	end
end)

